<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClickYa.Views.SolicitarServicioPage"
             BackgroundColor="#0A0A1A" Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Grid ColumnDefinitions="Auto,*" Margin="0,16,0,0">
                <Label Text="‹" FontSize="38" TextColor="White" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnVolverTapped"/></Label.GestureRecognizers>
                </Label>
                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0">
                    <Label Text="Publicar urgencia" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Los técnicos Premium podrán enviarte ofertas" FontSize="13" TextColor="#FF2E88"/>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Rubro" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Frame CornerRadius="16" Padding="12,0" BackgroundColor="#1A1A2E" BorderColor="#2A2A3E" HasShadow="False">
                <Picker x:Name="PickerCategoria" Title="Seleccioná un rubro" TextColor="White"
                        TitleColor="#777" ItemDisplayBinding="{Binding Nombre}"/>
            </Frame>

            <Label Text="Describí el problema" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Frame CornerRadius="16" Padding="14" BackgroundColor="#1A1A2E" BorderColor="#2A2A3E" HasShadow="False">
                <Editor x:Name="EditorDescripcion" Placeholder="Contá qué está pasando..." PlaceholderColor="#666"
                        HeightRequest="100" TextColor="White" BackgroundColor="Transparent"/>
            </Frame>

            <Label Text="Foto del problema (opcional)" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Frame HeightRequest="160" CornerRadius="18" Padding="0" BackgroundColor="#1A1A2E"
                   BorderColor="#2A2A3E" HasShadow="False">
                <Frame.GestureRecognizers><TapGestureRecognizer Tapped="OnTomarFotoTapped"/></Frame.GestureRecognizers>
                <Grid>
                    <Label Text="📷  Tocá para agregar una foto" TextColor="#777" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Image x:Name="ImgFoto" Aspect="AspectFill" IsVisible="False"/>
                </Grid>
            </Frame>

            <Label Text="Zona o barrio" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Entry x:Name="EntryZona" Placeholder="Ej: Centro" StyleClass="" TextColor="White"
                   PlaceholderColor="#666" BackgroundColor="#1A1A2E"/>

            <Label Text="Dirección exacta" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Entry x:Name="EntryDireccion" Placeholder="Calle y número" TextColor="White"
                   PlaceholderColor="#666" BackgroundColor="#1A1A2E"/>
            <Label Text="La dirección sólo se mostrará al técnico que elijas." FontSize="12" TextColor="#999"/>

            <Label Text="Tu WhatsApp o teléfono" FontSize="16" FontAttributes="Bold" TextColor="White"/>
            <Entry x:Name="EntryContacto" Placeholder="Ej: 5493364612832" Keyboard="Telephone"
                   TextColor="White" PlaceholderColor="#666" BackgroundColor="#1A1A2E"/>
            <Label Text="El contacto permanecerá privado hasta que selecciones una oferta." FontSize="12" TextColor="#999"/>

            <Button x:Name="BtnEnviar" Text="Publicar urgencia" BackgroundColor="#5C0BBF" TextColor="White"
                    FontAttributes="Bold" CornerRadius="18" HeightRequest="56" Clicked="OnEnviarTapped"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
